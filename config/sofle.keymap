#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include "keys_pt_abnt2.h"

#define BASE 0
#define NAV_NUM 1
#define SYMBOLS 2
#define VSCODE_OS 3
#define SYSTEM 4

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_bspc_left {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&kp BACKSPACE>;
        };

        combo_enter_left {
            timeout-ms = <50>;
            key-positions = <26 27>;
            bindings = <&kp RET>;
        };

        combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <0 11>;
            bindings = <&studio_unlock>;
        };

        backspace_right {
            bindings = <&kp BACKSPACE>;
            key-positions = <19 20>;
            timeout-ms = <50>;
        };
    };

    macros {
        arrow_dot_php: arrow_dot_php {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp PT_MINUS &kp PT_GREATER_THAN>;
            label = "ARROW_DOT_PHP";
        };

        array_php: array {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp PT_EQUAL &kp PT_GREATER_THAN>;
            label = "ARRAY";
        };

        selecionar_palavra: deletar_palavra {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LEFT) &kp LC(LS(RIGHT))>;
            label = "DELETAR_PALAVRA";
        };

        buscar_favoritos: buscar_favoritos {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(PT_T) &kp PT_ASTERISK &kp SPACE>;
            label = "BUSCAR_FAVORITOS";
        };

        selecionar_linha: selecionar_linha {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME &kp LS(END)>;
            label = "SELECIONAR_LINHA";
        };
    };

    behaviors {
        copiar: copiar {
            compatible = "zmk,behavior-tap-dance";
            label = "COPIAR";
            #binding-cells = <0>;
            bindings = <&kp LC(PT_C)>, <&kp LC(LS(PT_C))>;

            tapping-term-ms = <300>;
        };

        single_quote_copyQ: single_quote_copyQ {
            compatible = "zmk,behavior-tap-dance";
            label = "SINGLE_QUOTE_COPYQ";
            #binding-cells = <0>;
            bindings = <&kp PT_SQT>, <&kp LA(DELETE)>;

            tapping-term-ms = <300>;
        };

        lt_pref: layer_tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_PREFERRED";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";

            // LAYER 0: BASE com Home Row Mods
            // Mão Esquerda (Segurar): A=Super, S=Alt, D=Ctrl, F=Shift
            // Mão Direita (Segurar): J=Shift, K=Ctrl, L=Alt, ;=Super

            bindings = <
&single_quote_copyQ  &kp N1      &kp N2      &kp N3        &kp N4        &kp N5                                                    &kp N6            &kp N7            &kp N8       &kp N9               &kp N0                 &kp LS(LA(LC(PT_L)))
&kp TAB              &kp Q       &kp W       &kp E         &kp R         &kp T                                                     &kp Y             &kp U             &kp I        &kp O                &kp P                  &kp PT_ACUTE
&kp LEFT_SHIFT       &hm LWIN A  &hm LALT S  &hm LCTRL D   &hm LSHIFT F  &kp G                                                     &kp H             &hm LEFT_SHIFT J  &hm LCTRL K  &hm LEFT_ALT L       &hm LGUI PT_SEMICOLON  &kp PT_TILDE
&kp LEFT_CONTROL     &kp Z       &kp X       &kp C         &kp V         &kp B           &kp CAPSLOCK        &kp LS(LA(LC(PT_M)))  &kp N             &kp M             &kp COMMA    &kp DOT              &kp PT_QUESTION        &kp PT_C_CEDILLA
                                 &copiar     &kp LC(PT_V)  &kp LEFT_ALT  &lt_pref 2 ESC  &lt_pref 3 SPACE    &kp BACKSPACE         &lt_pref 1 ENTER  &kp DELETE        &tog 5       &lt_pref 4 LEFT_GUI
            >;

            sensor-bindings =
                <&inc_dec_kp K_VOL_UP K_VOLUME_DOWN>,
                <&inc_dec_kp PAGE_UP PG_DN>;
        };

        nav {
            display-name = "NAV";
            bindings = <
&kp F1  &kp F2         &kp F3                 &kp F4                     &kp F5                               &kp F6                               &kp F7     &kp F8            &kp F9          &kp F10     &kp F11     &kp F12
&trans  &none          &kp LA(LC(LG(POUND)))  &kp LA(LC(LG(AT_SIGN)))    &kp LC(LA(LG(EXCLAMATION)))          &buscar_favoritos                    &none      &kp HOME          &kp UP          &kp END     &trans      &trans
&trans  &hm LGUI PT_A  &hm LEFT_ALT PT_S      &hm LEFT_CONTROL LG(PT_M)  &hm LEFT_SHIFT LS(LC(LG(UP_ARROW)))  &trans                               &kp SPACE  &kp LEFT_ARROW    &kp DOWN        &kp RIGHT   &trans      &kp PRINTSCREEN
&trans  &none          &tog 1                 &none                      &kp LC(LG(LS(DOWN)))                 &trans             &trans    &trans  &tog 1     &kp C_PLAY_PAUSE  &kp C_PREVIOUS  &kp C_NEXT  &kp K_CALC  &trans
                       &trans                 &trans                     &trans                               &trans             &trans    &trans  &trans     &trans            &trans          &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LS(LA(LC(UP))) LS(LA(LC(DOWN)))>,
                <&inc_dec_kp UP DOWN>;
        };

        symbols {
            display-name = "SYMBOLS";
            bindings = <
&tog 2  &trans         &trans       &kp PT_AT      &trans        &trans                            &trans        &trans        &trans                   &trans                 &trans          &trans
&trans  &kp BACKSLASH  &kp PT_PIPE  &kp PT_DOLLAR  &kp STAR      &kp PT_AMPS                       &kp PT_PLUS   &kp PT_MINUS  &kp PT_LEFT_BRACE        &kp PT_RIGHT_BRACE     &trans          &trans
&trans  &kp EXCL       &kp LT       &kp PT_UNDER   &kp GT        &arrow_dot_php                    &kp PT_SLASH  &kp PT_COLON  &kp PT_LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LS(PT_SQT)  &trans
&trans  &trans         &trans       &kp PT_PLUS    &kp PT_MINUS  &array_php      &trans    &trans  &kp PT_HASH   &kp PT_EQUAL  &kp PT_LEFT_BRACKET      &kp PT_RIGHT_BRACKET   &trans          &trans
                       &trans       &trans         &trans        &trans          &trans    &trans  &trans        &trans        &trans                   &trans
            >;

            sensor-bindings =
                <&inc_dec_kp K_VOLUME_UP K_VOLUME_DOWN>,
                <&inc_dec_kp K_SCROLL_DOWN K_SCROLL_UP>;
        };

        vscode {
            display-name = "VSCODE";
            bindings = <
&tog 3  &kp F1            &kp F2                &kp F3               &kp F4             &kp F5                          &kp LA(PT_X)      &kp LA(F1)         &trans        &trans            &trans                &kp LC(F8)
&trans  &kp LA(PT_MINUS)  &kp LC(LS(PT_J))      &selecionar_linha    &trans             &kp LC(HOME)                    &kp LA(HOME)      &kp LA(PT_W)       &kp LA(PT_A)  &kp LA(PT_Z)      &kp LS(LA(LC(PT_U)))  &trans
&trans  &kp LA(PT_EQUAL)  &trans                &selecionar_palavra  &kp LC(LS(ENTER))  &kp LC(END)                     &kp LC(LA(UP))    &kp LC(RS(ENTER))  &kp LC(PT_E)  &kp LC(LS(PT_P))  &trans                &trans
&trans  &trans            &kp LC(LS(LA(PT_U)))  &trans               &kp LC(LA(ENTER))  &trans        &trans    &trans  &kp LC(LA(DOWN))  &kp LA(LC(ENTER))  &kp LA(PT_P)  &trans            &trans                &trans
                          &trans                &trans               &trans             &trans        &trans    &trans  &trans            &trans             &trans        &trans
            >;

            sensor-bindings =
                <&inc_dec_kp K_VOL_UP K_VOL_DN>,
                <&inc_dec_kp UP DOWN>;
        };

        system {
            display-name = "SYSTEM";
            bindings = <
&sys_reset  &bt BT_SEL 0       &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                              &trans  &trans  &trans  &trans  &trans  &sys_reset
&trans      &bt BT_CLR         &trans        &trans        &trans        &trans                                    &trans  &trans  &trans  &trans  &trans  &trans
&trans      &ext_power EP_TOG  &trans        &trans        &trans        &trans                                    &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans             &trans        &trans        &trans        &trans        &bootloader    &bootloader  &trans  &trans  &trans  &trans  &trans  &trans
                               &trans        &trans        &trans        &trans        &none          &none        &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        NUM {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans        &trans     &trans     &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp PT_SLASH  &kp PT_N7  &kp PT_N8  &kp PT_N9     &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp PT_COLON  &kp PT_N4  &kp PT_N5  &kp PT_N6     &kp PT_PLUS   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp PT_DOT    &kp PT_N1  &kp PT_N2  &kp PT_N3     &kp PT_MINUS  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans        &kp N0     &trans     &kp PT_COMMA
            >;

            label = "NUM";
        };
    };
};

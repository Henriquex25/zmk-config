#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

// Definição dos nomes das Layers para facilitar a leitura
#define BASE 0
#define NAV_NUM 1
#define SYMBOLS 2
#define VSCODE_OS 3
#define SYSTEM 4

/ {
    // Bloco de Combos (Atalhos rápidos pressionando duas teclas juntas)
    combos {
        compatible = "zmk,combos";
        
        // Pressionar Q e W juntos = ESC (Perfeito para sair do Insert no VIM)
        combo_esc {
            timeout-ms = <50>;
            key-positions = <13 14>;
            bindings = <&kp ESC>;
        };
        
        // Pressionar J e K juntos = ENTER (Agiliza pular linha no código)
        combo_enter {
            timeout-ms = <50>;
            key-positions = <31 32>;
            bindings = <&kp RET>;
        };

         
         // Destravar mudanças feitas pelo ZMK Studio
         combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <0 11>;
            bindings = <&studio_unlock>;
        };


    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // LAYER 0: BASE (Letras QWERTY, polegares otimizados)
            bindings = <
&kp GRAVE &kp N1 &kp N2   &kp N3   &kp N4    &kp N5                             &kp N6 &kp N7    &kp N8    &kp N9   &kp N0   &kp BSPC
&kp TAB   &kp Q  &kp W    &kp E    &kp R     &kp T                              &kp Y  &kp U     &kp I     &kp O    &kp P    &kp BSLH
&kp ESC   &kp A  &kp S    &kp D    &kp F     &kp G                              &kp H  &kp J     &kp K     &kp L    &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X    &kp C    &kp V     &kp B  &kp C_MUTE      &kp C_PP  &kp N  &kp M     &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
                 &kp LALT &kp LGUI &kp LCTRL &mo NAV_NUM &kp SPACE  &kp RET   &mo SYMBOLS &sl VSCODE_OS &kp RALT &kp RCTRL
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_DN PG_UP>;
        };

        nav_num_layer {
            // LAYER 1: NAVEGAÇÃO E NÚMEROS (Segura Polegar Esquerdo)
            bindings = <
&kp F1    &kp F2 &kp F3 &kp F4 &kp F5 &kp F6                        &kp F7   &kp F8   &kp F9    &kp F10   &kp F11   &kp F12
&trans    &kp N7 &kp N8 &kp N9 &trans &trans                        &kp HOME &kp PG_DN &kp PG_UP &kp END   &trans    &kp DEL
&trans    &kp N4 &kp N5 &kp N6 &trans &trans                        &kp LEFT &kp DOWN  &kp UP    &kp RIGHT &trans    &trans
&trans    &kp N1 &kp N2 &kp N3 &trans &trans  &trans        &trans  &trans   &trans    &trans    &trans    &trans    &trans
                 &trans &trans &trans &trans  &trans        &trans  &mo SYSTEM &trans  &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp LC(EQUAL) LC(MINUS) &inc_dec_kp UP DOWN>;
        };

        symbols_layer {
            // LAYER 2: SÍMBOLOS PARA PROGRAMAÇÃO (Segura Polegar Direito)
            bindings = <
&trans    &trans    &trans   &trans   &trans    &trans                      &trans    &trans    &trans   &trans   &trans   &trans
&trans    &trans    &trans   &kp AMPS &kp STAR  &trans                      &trans    &kp LBKT  &kp RBKT &trans   &trans   &trans
&trans    &kp EXCL  &kp LT   &kp EQUAL &kp GT   &kp DLLR                    &trans    &kp LBRC  &kp RBRC &trans   &trans   &trans
&trans    &trans    &trans   &kp MINUS &kp UNDER &trans  &trans      &trans  &trans   &kp LPAR  &kp RPAR &trans   &trans   &trans
                     &trans   &trans   &trans   &mo SYSTEM &trans      &trans  &trans    &trans    &trans   &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        vscode_os_layer {
            // LAYER 3: WORKFLOW, VSCODE E OS (Tocar no Polegar Direito para ativar)
            bindings = <
&trans    &trans       &trans       &trans       &trans       &trans                                     &trans       &trans        &trans        &trans        &trans    &trans
&trans    &kp LG(N1)   &kp LG(N2)   &kp LG(N3)   &kp LG(N4)   &kp LG(N5)                                 &kp LC(Y)    &kp LC(Z)     &trans        &trans        &trans    &trans
&trans    &kp LG(LEFT) &kp LG(DOWN) &kp LG(UP)   &kp LG(RIGHT) &kp LG(M)                                  &kp LC(B)    &kp LS(LC(E)) &kp LS(LC(F)) &kp LS(LC(P)) &trans    &trans
&trans    &trans       &trans       &trans       &trans       &kp LG(T)  &trans      &trans  &trans       &trans        &trans        &trans        &trans    &trans
                       &trans       &trans       &trans       &trans     &trans      &trans  &trans       &trans        &trans        &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        system_layer {
            // LAYER 4: SYSTEM E BLUETOOTH (Segurar Polegar Esq + Polegar Dir)
            bindings = <
&trans     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                       &trans &trans &trans &trans &trans &trans
&trans     &bt BT_CLR   &trans       &trans       &trans       &trans                                   &trans &trans &trans &trans &trans &trans
&trans     &ext_power EP_TOG &trans  &trans       &trans       &trans                                   &trans &trans &trans &trans &trans &trans
&trans     &trans       &trans       &trans       &trans       &trans      &sys_reset &sys_reset &trans &trans &trans &trans &trans &trans
                        &trans       &trans       &trans       &trans      &bootloader &bootloader &trans &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};

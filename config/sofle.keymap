#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include "keys_pt_abnt2.h"

#define BASE       0
#define NAV_RIGHT  1
#define NAV_LEFT   2
#define SYMBOLS    3
#define VSCODE_OS  4
#define SYSTEM     5
#define NUM        6
#define GAME       7
#define GAME_2     8

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 5>;
            bindings = <&kp ESC>;
        };

        combo_bspc_left {
            timeout-ms = <50>;
            key-positions = <16 14>;
            bindings = <&kp BACKSPACE>;
        };

        combo_enter_left {
            timeout-ms = <50>;
            key-positions = <38 40>;
            bindings = <&kp RET>;
        };

        combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <0 11>;
            bindings = <&studio_unlock>;
        };

        backspace_right {
            bindings = <&kp BACKSPACE>;
            key-positions = <19 21>;
            timeout-ms = <50>;
        };

        right_space {
            bindings = <&kp PT_SPACE>;
            key-positions = <31 33>;
        };

        caps_word_right {
            bindings = <&caps_word>;
            key-positions = <7 8>;
            layers = <0>;
        };

        caps_word_left {
            bindings = <&caps_word>;
            key-positions = <3 4>;
            layers = <0>;
        };
    };

    macros {
        arrow_notation_php: arrow_dot_php {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp PT_MINUS &kp PT_GREATER_THAN>;
            label = "ARROW_DOT_PHP";
        };

        array_notation: array {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp PT_EQUAL &kp PT_GREATER_THAN>;
            label = "ARRAY";
        };

        buscar_favoritos: buscar_favoritos {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(PT_T) &kp PT_ASTERISK &kp SPACE>;
            label = "BUSCAR_FAVORITOS";
        };

        selecionar_linha: selecionar_linha {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME &kp LS(END)>;
            label = "SELECIONAR_LINHA";
        };
    };

    behaviors {
        copiar: copiar {
            compatible = "zmk,behavior-tap-dance";
            label = "COPIAR";
            #binding-cells = <0>;
            bindings = <&kp LC(PT_C)>, <&kp LC(LS(PT_C))>;

            tapping-term-ms = <300>;
        };

        lt_c: layer_tap_custom {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_CUSTOM";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <240>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <100>;
            hold-trigger-key-positions = <
                 6  7  8  9 10 11
                18 19 20 21 22 23
                30 31 32 33 34 35
                44 45 46 47 48 49
                57 58 59 60 61
            >;

            hold-trigger-on-release;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <100>;
            hold-trigger-key-positions = <
                 0  1  2  3  4  5
                12 13 14 15 16 17
                24 25 26 27 28 29
                36 37 38 39 40 41
                52 53 54 55 56
            >;

            hold-trigger-on-release;
        };

        hold_tap: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
        };

        colar: colar {
            compatible = "zmk,behavior-tap-dance";
            label = "COLAR";
            #binding-cells = <0>;
            bindings = <&kp LC(PT_V)>, <&kp LC(LS(PT_V))>;

            tapping-term-ms = <300>;
        };

        h_dois_pontos: h_dois_pontos {
            compatible = "zmk,behavior-tap-dance";
            label = "H_DOIS_PONTOS";
            #binding-cells = <0>;
            bindings = <&kp PT_H>, <&kp PT_COLON>;
        };

        altgr_tap: altgr_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";

            // LAYER 0: BASE com Home Row Mods
            // Mão Esquerda (Segurar): A=Super, S=Alt, D=Ctrl, F=Shift
            // Mão Direita (Segurar): J=Shift, K=Ctrl, L=Alt, ;=Super

            bindings = <
&hold_tap LA(DELETE) PT_DOUBLE_QUOTES  &kp N1       &kp N2       &kp N3        &kp N4         &kp N5                                           &kp N6          &kp N7             &kp N8                                 &kp N9           &kp N0                  &kp PT_MINUS
&kp TAB                                &kp Q        &kp W        &kp E         &kp R          &kp T                                            &kp Y           &kp U              &kp I                                  &kp O            &kp P                   &kp PT_ACUTE
&kp LEFT_SHIFT                         &hml LWIN A  &hml LALT S  &hml LCTRL D  &hml LSHIFT F  &kp G                                            &h_dois_pontos  &hmr LEFT_SHIFT J  &hmr LCTRL K                           &hmr LEFT_ALT L  &hmr LGUI PT_SEMICOLON  &kp PT_TILDE
&kp LEFT_CONTROL                       &kp Z        &kp X        &kp C         &kp V          &kp B      &kp CAPSLOCK    &kp LS(LA(LC(PT_M)))  &kp N           &kp M              &kp COMMA                              &kp DOT          &kp PT_QUESTION         &kp PT_C_CEDILLA
                                                    &colar       &copiar       &kp LEFT_ALT   &lt 2 ESC  &lt 3 SPACE     &lt 4 BACKSPACE       &lt 1 ENTER     &kp DELETE         &altgr_tap RIGHT_ALT LC(LA(PT_SPACE))  &lt 5 LEFT_GUI
            >;

            sensor-bindings =
                <&inc_dec_kp K_VOL_UP K_VOLUME_DOWN>,
                <&inc_dec_kp UP DOWN>;
        };

        nav_right {
            display-name = "NAV RIGHT";
            label = "NAV RIGHT";
            bindings = <
&kp F1  &kp F2          &kp F3                 &kp F4                      &kp F5                       &kp F6                                &kp F7        &kp F8          &kp F9              &kp F10               &kp F11  &kp F12
&trans  &trans          &kp LA(LC(LG(POUND)))  &kp LA(LC(LG(AT_SIGN)))     &kp LC(LA(LG(EXCLAMATION)))  &buscar_favoritos                     &kp LG(PT_M)  &kp HOME        &kp UP              &kp END               &kp F16  &tog 1
&trans  &hml LGUI PT_A  &hml LEFT_ALT PT_S     &hml LEFT_CONTROL LG(PT_M)  &hml LEFT_SHIFT LC(HOME)     &kp LS(LC(LG(UP)))                    &kp SPACE     &kp LEFT_ARROW  &kp DOWN            &kp RIGHT             &kp F15  &kp PRINTSCREEN
&trans  &trans          &kp C_PLAY_PAUSE       &kp C_PREV                  &kp C_NEXT                   &trans              &trans    &trans  &kp LC(HOME)  &kp LC(END)     &kp LS(LC(LG(UP)))  &kp LS(LC(LG(DOWN)))  &kp F13  &to 6
                        &trans                 &trans                      &trans                       &trans              &trans    &trans  &trans        &trans          &trans              &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LS(LA(LC(UP))) LS(LA(LC(DOWN)))>,
                <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>;
        };

        nav_left {
            display-name = "NAV LEFT";
            label = "NAV LEFT";
            bindings = <
&kp F1           &kp F2   &kp F3              &kp F4                &kp F5        &kp F6                          &kp F7             &kp F8                       &kp F9                   &kp F10                &kp F11                 &kp F12
&tog 2           &kp F16  &kp HOME            &kp UP                &kp END       &kp LG(PT_M)                    &buscar_favoritos  &kp LC(LA(LG(EXCLAMATION)))  &kp LA(LC(LG(AT_SIGN)))  &kp LA(LC(LG(POUND)))  &trans                  &trans
&kp PRINTSCREEN  &kp F15  &kp LEFT            &kp DOWN              &kp RIGHT     &kp SPACE                       &trans             &trans                       &trans                   &hmr LEFT_ALT PT_L     &hmr LGUI PT_SEMICOLON  &trans
&to 6            &kp F13  &kp LS(LG(LC(UP)))  &kp LS(LC(LG(DOWN)))  &kp LC(HOME)  &kp LC(END)   &trans    &trans  &trans             &kp C_PLAY_PAUSE             &kp C_PREV               &kp C_NEXT             &trans                  &trans
                          &trans              &trans                &trans        &trans        &trans    &trans  &trans             &trans                       &trans                   &trans
            >;

            sensor-bindings =
                <&inc_dec_kp UP DOWN>,
                <&inc_dec_kp LS(LA(LC(UP))) LS(LA(LC(DOWN)))>;
        };

        symbols {
            display-name = "SYMBOLS";
            bindings = <
&kp F1  &kp F2            &kp F3       &kp F4         &kp F5        &kp F6                                &trans               &trans        &kp PT_AT                &trans                 &kp PT_DEGREE  &kp RA(PT_RIGHT_BRACKET)
&tog 3  &kp PT_BACKSLASH  &kp PT_PIPE  &kp PT_DOLLAR  &kp STAR      &kp PT_AMPS                           &arrow_notation_php  &kp PT_MINUS  &kp PT_LEFT_BRACE        &kp PT_RIGHT_BRACE     &trans         &trans
&trans  &kp PT_PERCENT    &kp LT       &kp PT_UNDER   &kp GT        &kp PT_SLASH                          &array_notation      &kp PT_EQUAL  &kp PT_LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PT_SQT     &trans
&trans  &trans            &trans       &kp PT_PLUS    &kp PT_MINUS  &kp PT_EXCLAMATION  &trans    &trans  &kp PT_HASH          &kp PT_COLON  &kp PT_LEFT_BRACKET      &kp PT_RIGHT_BRACKET   &trans         &trans
                          &trans       &trans         &trans        &trans              &trans    &trans  &kp PT_SPACE         &trans        &trans                   &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PAGE_UP PAGE_DOWN>;
        };

        vscode {
            display-name = "VSCODE";
            bindings = <
&kp F1  &kp F2            &kp F3                &kp F4             &kp F5        &kp F6                               &kp LA(PT_X)      &kp LA(F1)    &kp LC(INSERT)    &kp LA(INSERT)  &trans                &kp LC(F8)
&tog 4  &kp LA(PT_MINUS)  &kp LC(LS(PT_J))      &selecionar_linha  &kp LC(PT_D)  &trans                               &kp LA(HOME)      &kp LA(PT_W)  &kp LA(PT_A)      &kp LA(PT_Z)    &kp LS(LA(LC(PT_U)))  &trans
&trans  &kp LA(PT_EQUAL)  &trans                &kp LC(PT_E)       &trans        &kp LS(LC(ENTER))                    &kp LC(LA(UP))    &kp LA(PT_P)  &kp LS(LC(PT_P))  &trans          &trans                &trans
&trans  &trans            &kp LC(LS(LA(PT_U)))  &trans             &trans        &kp LA(LC(ENTER))  &trans    &trans  &kp LC(LA(DOWN))  &trans        &trans            &trans          &trans                &trans
                          &trans                &trans             &trans        &trans             &trans    &trans  &trans            &trans        &trans            &trans
            >;

            sensor-bindings =
                <&inc_dec_kp K_VOL_UP K_VOL_DN>,
                <&inc_dec_kp UP DOWN>;
        };

        system {
            display-name = "SYSTEM";
            bindings = <
&sys_reset   &bt BT_SEL 0       &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans  &trans  &trans  &trans  &trans  &sys_reset
&trans       &bt BT_CLR         &trans        &out OUT_BLE  &trans        &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans       &ext_power EP_ON   &trans        &out OUT_USB  &trans        &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&bootloader  &ext_power EP_OFF  &trans        &trans        &trans        &trans        &to 7     &to 7   &trans  &trans  &trans  &trans  &trans  &bootloader
                                &trans        &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        num {
            bindings = <
&trans  &trans          &trans      &trans        &trans  &trans                             &trans           &trans     &trans        &trans      &trans          &trans
&trans  &kp PT_PERCENT  &kp N9      &kp N8        &kp N7  &kp PT_ASTERISK                    &kp PT_ASTERISK  &kp PT_N7  &kp PT_N8     &kp PT_N9   &kp PT_PERCENT  &trans
&trans  &kp PT_PLUS     &kp N6      &kp N5        &kp N4  &kp PT_SLASH                       &kp PT_SLASH     &kp PT_N4  &kp PT_N5     &kp PT_N6   &kp PT_PLUS     &trans
&to 0   &kp PT_MINUS    &kp N3      &kp N2        &kp N1  &kp PT_COLON     &trans    &trans  &kp PT_COLON     &kp PT_N1  &kp PT_N2     &kp PT_N3   &kp PT_MINUS    &to 0
                        &kp PT_DOT  &kp PT_COMMA  &kp N0  &trans           &trans    &trans  &trans           &kp N0     &kp PT_COMMA  &kp PT_DOT
            >;

            label = "NUM";
        };

        game {
            bindings = <
&kp CAPSLOCK          &kp PT_N1       &kp PT_N2     &kp PT_N3            &kp PT_N4  &kp PT_N5                                    &kp PT_N6  &kp PT_N7      &kp PT_N8  &kp PT_N9   &kp N0           &kp BACKSPACE
&kp PT_T              &kp TAB         &kp PT_Q      &kp PT_W             &kp PT_E   &kp PT_R                                     &kp Y      &kp U          &kp I      &kp O       &kp P            &kp PT_ACUTE
&kp PT_RIGHT_BRACKET  &kp LEFT_SHIFT  &kp PT_A      &kp PT_S             &kp PT_D   &kp G                                        &kp H      &kp J          &kp K      &kp L       &kp SEMI         &kp PT_TILDE
&kp PT_Z              &kp LCTRL       &kp X         &kp C                &kp V      &kp B      &kp LG(LA(PT_K))    &to 0         &kp N      &kp M          &kp COMMA  &kp DOT     &kp PT_QUESTION  &kp PT_C_CEDILLA
                                      &kp LEFT_ALT  &kp PT_LEFT_BRACKET  &lt 8 ESC  &kp PT_F   &kp PT_SPACE        &kp PT_SPACE  &kp ENTER  &kp BACKSPACE  &kp LGUI   &kp DELETE
            >;

            label = "GAME";
            sensor-bindings =
                <&inc_dec_kp PAGE_UP PAGE_DOWN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        game_2 {
            bindings = <
&kp F1   &kp F2      &kp F3   &kp F4   &kp F5   &kp F6                     &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&kp F19  &kp ESCAPE  &trans   &trans   &trans   &kp F13                    &trans  &trans  &trans  &trans   &trans   &trans
&kp F20  &trans      &trans   &trans   &trans   &kp F14                    &trans  &trans  &trans  &trans   &trans   &trans
&kp F21  &trans      &kp F18  &kp F17  &kp F16  &kp F15  &trans    &trans  &trans  &trans  &trans  &trans   &trans   &trans
                     &trans   &trans   &trans   &trans   &trans    &trans  &trans  &trans  &trans  &trans
            >;

            label = "GAME 2";
        };
    };
};

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include "keys_pt_abnt2.h"

// Definição dos nomes das Layers para facilitar a leitura

#define BASE 0
#define NAV_NUM 1
#define SYMBOLS 2
#define VSCODE_OS 3
#define SYSTEM 4

/ {
    // Bloco de Combos (Atalhos rápidos pressionando duas teclas juntas)

    combos {
        compatible = "zmk,combos";

        // Pressionar Q e W juntos = ESC (Perfeito para sair do Insert no VIM)

        combo_esc {
            timeout-ms = <50>;
            key-positions = <13 14>;
            bindings = <&kp ESC>;
        };

        // Pressionar J e K juntos = ENTER (Agiliza pular linha no código)

        combo_enter {
            timeout-ms = <50>;
            key-positions = <31 32>;
            bindings = <&kp RET>;
        };

        // Destravar mudanças feitas pelo ZMK Studio

        combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <0 11>;
            bindings = <&studio_unlock>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";

            // LAYER 0: BASE (Letras QWERTY, polegares otimizados)

            bindings = <
&kp PT_SQT    &kp N1  &kp N2   &kp N3            &kp N4        &kp N5                                           &kp N6       &kp N7     &kp N8      &kp N9   &kp N0    &kp RS(CARET)
&kp TAB       &kp Q   &kp W    &kp E             &kp R         &kp T                                            &kp Y        &kp U      &kp I       &kp O    &kp P     &kp PT_ACUTE
&kp LC(PT_C)  &kp A   &kp S    &kp D             &kp F         &kp G                                            &kp H        &kp J      &kp K       &kp L    &kp SEMI  &kp PT_C_CEDILLA
&kp LC(PT_V)  &kp Z   &kp X    &kp C             &kp V         &kp B             &kp CAPSLOCK    &kp C_MUTE     &kp N        &kp M      &kp COMMA   &kp DOT  &kp FSLH  &kp PT_TILDE
                      &kp ESC  &kp LEFT_CONTROL  &kp LEFT_ALT  &lt 2 LEFT_SHIFT  &lt 3 SPACE     &kp BACKSPACE  &lt 1 LSHFT  &kp ENTER  &kp DELETE  &mo 4
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_DN PG_UP>;
        };

        nav {
            display-name = "NAV NUM";

            // LAYER 1: NAVEGAÇÃO E NÚMEROS (Segura Polegar Esquerdo)

            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6                    &kp F7      &kp F8          &kp F9    &kp F10    &kp F11  &kp F12
&trans  &none   &none   &none   &trans  &trans                    &none       &kp HOME        &kp UP    &kp END    &trans   &kp DEL
&trans  &none   &none   &none   &trans  &trans                    &none       &kp LEFT_ARROW  &kp DOWN  &kp RIGHT  &trans   &trans
&trans  &none   &none   &none   &trans  &trans  &trans    &trans  &trans      &trans          &trans    &trans     &trans   &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &mo SYSTEM  &trans          &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(EQUAL) LC(MINUS) &inc_dec_kp UP DOWN>;
        };

        symbols {
            display-name = "SYMBOLS";

            // LAYER 2: SÍMBOLOS PARA PROGRAMAÇÃO (Segura Polegar Direito)

            bindings = <
&trans  &trans         &trans    &kp PT_AT      &trans    &trans                         &trans       &trans           &trans                   &trans                 &trans        &trans
&trans  &kp BACKSLASH  &kp PIPE  &kp PT_DOLLAR  &kp STAR  &kp PT_AMPS                    &trans       &kp PT_MINUS     &kp PT_LEFT_BRACE        &kp RIGHT_BRACE        &trans        &trans
&trans  &kp EXCL       &kp LT    &kp PT_UNDER   &kp GT    &trans                         &kp PT_HASH  &kp PT_EQUAL     &kp PT_LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PT_COLON  &trans
&trans  &trans         &trans    &trans         &trans    &trans       &trans    &trans  &trans       &kp PT_QUESTION  &kp PT_LEFT_BRACKET      &kp PT_RIGHT_BRACKET   &trans        &trans
                       &trans    &trans         &trans    &trans       &trans    &trans  &trans       &trans           &trans                   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        vscode {
            display-name = "VSCODE";

            // LAYER 3: WORKFLOW, VSCODE E OS (Tocar no Polegar Direito para ativar)

            bindings = <
&trans  &trans  &trans                &trans        &trans        &trans                          &kp LA(PT_X)  &kp LA(F1)         &trans             &trans  &trans        &trans
&trans  &trans  &trans                &trans        &kp LA(PT_K)  &kp LC(HOME)                    &trans        &trans             &kp LA(PT_P)       &trans  &kp LA(PT_Z)  &trans
&trans  &trans  &kp LA(PT_A)          &kp LA(PT_D)  &kp LA(PT_J)  &kp LC(END)                     &trans        &kp LC(RS(ENTER))  &kp LC(LA(ENTER))  &trans  &kp LA(PT_W)  &trans
&trans  &trans  &kp LC(LS(LA(PT_U)))  &trans        &trans        &trans        &trans    &trans  &trans        &trans             &trans             &trans  &trans        &trans
                &trans                &trans        &trans        &trans        &trans    &trans  &trans        &trans             &trans             &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        system_layer {
            display-name = "SYSTEM";

            // LAYER 4: SYSTEM E BLUETOOTH (Segurar Polegar Esq + Polegar Dir)

            bindings = <
&trans  &bt BT_SEL 0       &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR         &trans        &trans        &trans        &trans                                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &ext_power EP_TOG  &trans        &trans        &trans        &trans                                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans             &trans        &trans        &trans        &trans        &sys_reset     &sys_reset   &trans  &trans  &trans  &trans  &trans  &trans
                           &trans        &trans        &trans        &trans        &bootloader    &bootloader  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};

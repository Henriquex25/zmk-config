#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include "keys_pt_abnt2.h"

// Definição dos nomes das Layers para facilitar a leitura

#define BASE 0
#define NAV_NUM 1
#define SYMBOLS 2
#define VSCODE_OS 3
#define SYSTEM 4

/ {
    // Bloco de Combos (Atalhos rápidos pressionando duas teclas juntas)

    combos {
        compatible = "zmk,combos";

        // Pressionar Q e W juntos = ESC (Perfeito para sair do Insert no VIM)

        combo_esc {
            timeout-ms = <50>;
            key-positions = <13 14>;
            bindings = <&kp ESC>;
        };

        // Pressionar J e K juntos = ENTER (Agiliza pular linha no código)

        combo_enter {
            timeout-ms = <50>;
            key-positions = <31 32>;
            bindings = <&kp RET>;
        };

        // Destravar mudanças feitas pelo ZMK Studio

        combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <0 11>;
            bindings = <&studio_unlock>;
        };
    };

    macros {
        arrow_dot_php: arrow_dot_php {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp PT_MINUS &kp PT_GREATER_THAN>;
            label = "ARROW_DOT_PHP";
        };

        array_php: array {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp PT_EQUAL &kp PT_GREATER_THAN>;
            label = "ARRAY";
        };

        deletar_palavra: deletar_palavra {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LEFT) &kp LC(LS(RIGHT)) &kp BACKSPACE>;
            label = "DELETAR_PALAVRA";
        };

        excluir_linha_cima: excluir_linha_cima {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(UP) &kp END>;
            label = "EXCLUIR_LINHA_CIMA";
        };

        buscar_favoritos: buscar_favoritos {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(PT_T) &kp PT_ASTERISK &kp SPACE>;
            label = "BUSCAR_FAVORITOS";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";

            // LAYER 0: BASE (Letras QWERTY, polegares otimizados)

            bindings = <
&kp PT_SQT        &kp N1  &kp N2            &kp N3            &kp N4        &kp N5                                           &kp N6       &kp N7      &kp N8                &kp N9          &kp N0            &kp PT_ACUTE
&kp TAB           &kp Q   &kp W             &kp E             &kp R         &kp T                                            &kp Y        &kp U       &kp I                 &kp O           &kp P             &kp PT_C_CEDILLA
&kp LEFT_SHIFT    &kp A   &kp S             &kp D             &kp F         &kp G                                            &kp H        &kp J       &kp K                 &kp L           &kp PT_SEMICOLON  &kp PT_TILDE
&kp LEFT_CONTROL  &kp Z   &kp X             &kp C             &kp V         &kp B      &kp CAPSLOCK    &kp LS(LA(LC(PT_M)))  &kp N        &kp M       &kp COMMA             &kp DOT         &kp PT_QUESTION   &tog 5
                          &kp LC(LS(PT_V))  &kp LC(LS(PT_C))  &kp LEFT_ALT  &lt 2 ESC  &lt 3 SPACE     &kp BACKSPACE         &lt 1 ENTER  &kp DELETE  &kp LC(LS(LA(PT_L)))  &lt 4 LEFT_GUI
            >;

            sensor-bindings =
                <&inc_dec_kp PG_DN PG_UP>,
                <&inc_dec_kp PG_DN PG_UP>;
        };

        nav {
            display-name = "NAV";

            // LAYER 1: NAVEGAÇÃO E NÚMEROS (Segura Polegar Esquerdo)

            bindings = <
&kp F1  &kp F2  &kp F3                 &kp F4                   &kp F5                       &kp F6                               &kp F7  &kp F8            &kp F9          &kp F10     &kp F11     &kp F12
&trans  &none   &kp LA(LC(LG(POUND)))  &kp LA(LC(LG(AT_SIGN)))  &kp LC(LA(LG(EXCLAMATION)))  &buscar_favoritos                    &none   &kp HOME          &kp UP          &kp END     &trans      &trans
&trans  &none   &none                  &kp LG(PT_M)             &kp LC(LG(LS(UP)))           &trans                               &none   &kp LEFT_ARROW    &kp DOWN        &kp RIGHT   &trans      &kp PRINTSCREEN
&trans  &none   &none                  &none                    &kp LC(LG(LS(DOWN)))         &trans             &trans    &trans  &trans  &kp C_PLAY_PAUSE  &kp C_PREVIOUS  &kp C_NEXT  &kp K_CALC  &tog 1
                &trans                 &trans                   &trans                       &trans             &trans    &trans  &trans  &trans            &trans          &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>,
                <&inc_dec_kp UP DOWN>;
        };

        symbols {
            display-name = "SYMBOLS";

            // LAYER 2: SÍMBOLOS PARA PROGRAMAÇÃO (Segura Polegar Direito)

            bindings = <
&trans  &trans         &trans    &kp PT_AT      &trans    &trans                            &trans        &trans        &trans                   &trans                 &trans  &trans
&trans  &kp BACKSLASH  &kp PIPE  &kp PT_DOLLAR  &kp STAR  &kp PT_AMPS                       &trans        &kp PT_MINUS  &kp LEFT_BRACKET         &kp RIGHT_BRACKET      &trans  &trans
&trans  &kp EXCL       &kp LT    &kp PT_UNDER   &kp GT    &arrow_dot_php                    &kp PT_COLON  &kp PT_EQUAL  &kp PT_LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans  &trans
&trans  &trans         &trans    &trans         &trans    &array_php      &trans    &trans  &kp PT_HASH   &kp PT_SLASH  &kp PT_LEFT_BRACKET      &kp PT_RIGHT_BRACKET   &trans  &tog 2
                       &trans    &trans         &trans    &trans          &trans    &trans  &trans        &trans        &trans                   &trans
            >;

            sensor-bindings =
                <&inc_dec_kp K_VOLUME_UP K_VOLUME_DOWN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        vscode {
            display-name = "VSCODE";

            // LAYER 3: WORKFLOW, VSCODE E OS (Tocar no Polegar Direito para ativar)

            bindings = <
&trans  &trans  &trans                &trans               &trans            &trans                          &kp LA(PT_X)      &kp LA(F1)         &trans             &trans  &trans  &trans
&trans  &trans  &trans                &excluir_linha_cima  &trans            &kp LC(HOME)                    &kp LA(HOME)      &trans             &trans             &trans  &trans  &trans
&trans  &trans  &trans                &deletar_palavra     &kp LC(LS(PT_P))  &kp LC(END)                     &kp LC(LA(UP))    &kp LC(RS(ENTER))  &kp LC(LA(ENTER))  &trans  &trans  &trans
&trans  &trans  &kp LC(LS(LA(PT_U)))  &trans               &trans            &trans        &trans    &trans  &kp LC(LA(DOWN))  &trans             &trans             &trans  &trans  &tog 3
                &trans                &trans               &trans            &trans        &trans    &trans  &trans            &trans             &trans             &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        system {
            display-name = "SYSTEM";

            // LAYER 4: SYSTEM E BLUETOOTH (Segurar Polegar Esq + Polegar Dir)

            bindings = <
&sys_reset  &bt BT_SEL 0       &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                              &trans  &trans  &trans  &trans  &trans  &sys_reset
&trans      &bt BT_CLR         &trans        &trans        &trans        &trans                                    &trans  &trans  &trans  &trans  &trans  &trans
&trans      &ext_power EP_TOG  &trans        &trans        &trans        &trans                                    &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans             &trans        &trans        &trans        &trans        &bootloader    &bootloader  &trans  &trans  &trans  &trans  &trans  &trans
                               &trans        &trans        &trans        &trans        &none          &none        &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        NUM {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &kp PT_COLON  &kp PT_SLASH  &kp PT_ASTERISK  &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &kp PT_N7     &kp PT_N8     &kp PT_N9        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &kp PT_N4     &kp PT_N5     &kp PT_N6        &kp PT_PLUS   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &kp PT_N1     &kp PT_N2     &kp PT_N3        &kp PT_MINUS  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &kp N0        &kp PT_DOT    &kp PT_COMMA
            >;

            label = "NUM";
        };
    };
};
